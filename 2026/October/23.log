options:
  -h, --help            show this help message and exit
  --yes, -y             non-interactive: take the recommendation and every default
  --model ID            catalog model to install (see --list); default: the recommendation
  --model-dir DIR       use a model already on disk instead of downloading one
  --dir DIR             folder for downloaded models (default ~/colibri-models)
  --backend {auto,cpu,vulkan,cuda}
                        engine build: auto (default) picks CUDA when the toolkit builds for the
